{
  "name": "genlayer-sentinel",
  "version": "0.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "check:ic": "python3 scripts/check-intelligent-contract.py",
    "setup:ic:direct": "node scripts/setup-intelligent-contract-tests.mjs",
    "setup:assurance": "node scripts/setup-contract-assurance.mjs",
    "analyze:contracts": "node scripts/run-slither-assurance.mjs",
    "lint:ic": "node scripts/run-intelligent-contract-tool.mjs lint",
    "test:ic:direct": "node scripts/run-intelligent-contract-tool.mjs test",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "check:dashboard": "node --check apps/dashboard/src/app.js && node --check apps/dashboard/src/timeline.js && node --check dist/apps/dashboard/demo.js && node scripts/check-dashboard.mjs",
    "preflight": "npm run build && node dist/services/coordinator/src/preflight.js",
    "demo:local": "npm run build && node dist/services/coordinator/src/local-demo-cli.js",
    "recovery:prepare": "npm run build && node dist/services/coordinator/src/recovery-cli.js prepare",
    "recovery:apply": "npm run build && node dist/services/coordinator/src/recovery-cli.js apply",
    "build": "tsc -p tsconfig.json && npm run compile:contracts && npm run check:ic && npm run build:dashboard && npm run check:dashboard",
    "test": "npm run build && node --test scripts/test/*.test.js apps/dashboard/test/*.test.js packages/core/test/*.test.js services/coordinator/test/*.test.js contracts/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint:ic && npm run test:ic:direct && npm test"
  },
  "devDependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.168",
    "@layerzerolabs/lz-evm-v1-0.7": "3.0.168",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "esbuild": "0.28.1",
    "hardhat": "3.10.0",
    "solc": "0.8.30",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "ethers": "6.17.0"
  }
}
